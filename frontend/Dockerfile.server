# 서버 배포용 React + Nginx 이미지다.
# 로컬 HTTP 이미지는 frontend/Dockerfile.local을 사용한다.
FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:alpine

# EC2에서는 HTTPS 서버 설정을 이미지에 포함한다.
COPY nginx.server.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80 443
