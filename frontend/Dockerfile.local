# Docker Multi-stage build
# 1단계에서는 VITE를 활용하여 react소스를 빌드하여 브라우저가 실행할 수 있는 정적 HTML, CSS, JavaScript를 생성한다.
# 2단계에서는 Nginx로 빌드된 결과를 실행한다.

# 1단계: Vite가 React 소스를 운영용 정적 파일로 빌드한다.
FROM node:22-alpine AS build

WORKDIR /app

# 의존성 파일을 먼저 복사하면 소스만 바뀐 경우 Docker 캐시를 재사용할 수 있다.
COPY package.json package-lock.json ./
RUN npm ci

# React 소스를 복사하고 /app/dist에 HTML, CSS, JavaScript를 만든다.
COPY . .
RUN npm run build

# 2단계: Node/Vite 없이 Nginx만으로 빌드 결과를 제공한다.
FROM nginx:alpine

# 기본 Nginx 설정을 로컬 HTTP용 SPA·API 프록시 설정으로 교체한다.
COPY nginx.local.conf /etc/nginx/conf.d/default.conf

# 1단계에서 생성한 정적 파일만 최종 이미지로 가져온다.
COPY --from=build /app/dist /usr/share/nginx/html

# Nginx가 컨테이너 내부에서 HTTP 요청을 받는 포트다.
EXPOSE 80
